# Settings shared by every board. Board settings (flash size, partition table, pins, record control, LED) are in
# sdkconfig.defaults.<target>, which ESP-IDF applies after this file: `idf.py set-target esp32s3` (breadboard v0) or
# `idf.py set-target esp32c3` (C3 Super Mini).
# The target below is only a guess for a plain `idf.py build` in a fresh checkout; set-target overrides it.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Console on the native USB port (USB-Serial-JTAG on both the S3 and the C3). For a UART bridge board, use menuconfig:
# Component config -> ESP System Settings -> Channel for console output, and raise the baud to 921600.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# BLE sync (M2): NimBLE peripheral only, one bonded phone, keys persisted in NVS.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
# Central role only because NimBLE ties the GATT client (needed to start the MTU exchange) to it; never scans.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_SM_SC=y
# INFO reads run on the host task and walk the LittleFS directory.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
