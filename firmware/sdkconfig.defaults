CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Console on the native USB port (S3 USB-Serial-JTAG). For a UART bridge board, use menuconfig:
# Component config -> ESP System Settings -> Channel for console output, and raise the baud to 921600.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# BLE sync (M2): NimBLE peripheral only, one bonded phone, keys persisted in NVS.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
# Central role only because NimBLE ties the GATT client (needed to start the MTU exchange) to it; never scans.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_SM_SC=y
# INFO reads run on the host task and walk the LittleFS directory.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
# The v0 breadboard uses a latching toggle switch on GPIO7 (menuconfig -> ESPeak32 -> Record control).
CONFIG_ESPEAK32_BUTTON_SWITCH=y
